;;;;;; Martini 3 small molecule topology for PERFLUOROBUTANOIC-ACID (PFBA - PF04C)
;
; Description:
;   Martini 3 topology with optimized bonded parameters for linear perfluoroalkyl substances.
;
; Reference(s):
;   Calza, A.; Calvaresi, M.; Zerbetto, F.; Marrink, S. J. Martini 3 Coarse-Grain Model For Linear Perfluoroalkyl Substances.
;   J. Chem. Theory Comput. 2026, 22, 5284-5298. DOI: https://doi.org/10.1021/acs.jctc.6c00250
;
; Category
;   Surfactants
;
; Name
;   perfluorobutanoate
;
; Alias
;   PFBA - PF04C
;
; Force field
;   martini3001
;
; Version
;   1.0
;
; Note(s):
;   For minimizations, you may use define=-DFLEXIBLE to use a non stiff-bond version of the topology that is more amenable to minimization.
;

[ moleculetype ]
; molname    nrexcl
PF04C        1 

[ atoms ]
; nr type resnr residue atom cgnr charge mass
   1  SQ5n  1    PF04C  C1    1   -1	
   2  TX3   1    PF04C  F2    2    0	
   3  TX3   1    PF04C  F3    3    0	
   4  SX4   1    PF04C  F4    4    0	

#ifdef FLEXIBLE
[bonds]
; i  j  funct length
  1  2   1      0.235     15000 
  2  3   1      0.220     15000 
  3  4   1      0.230     15000 
#endif

#ifndef FLEXIBLE
[constraints]
; i  j  funct length
  1  2   1      0.235     15000
  2  3   1      0.220     15000
  3  4   1      0.230     15000
#endif

[ angles ]
; i  j  k  funct  ref.angle force_k
  1  2  3    1        96        500
  2  3  4    1        96        500  

[ dihedrals ]
; i  j  k  l   funct   phi0  kphi  mult
 1 2 3 4    9        0       5       4
 1 2 3 4    9        0       10      3

[ exclusions ]
1 2 3 4
2 3 4
3 4
